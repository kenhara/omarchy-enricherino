{
  "schemaVersion": 1,
  "id": "harris.enricherino",
  "name": "Enricherino",
  "version": "0.2.4",
  "author": "Harris Kenny",
  "license": "MIT",
  "description": "Paste one thing. Hit FIND. Get a contact card. Unofficial LeadMagic / ZoomInfo / GTM.AI waterfall enrichment; not affiliated.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "keywords": [
    "enricherino",
    "yellow pages",
    "contact lookup",
    "people search",
    "email finder",
    "enrich",
    "enrichment",
    "waterfall",
    "leadmagic",
    "zoominfo",
    "zoom info",
    "gtm.ai",
    "gtmai",
    "linkedin",
    "linked in",
    "reverse phone",
    "phone lookup",
    "email to linkedin",
    "sales osint",
    "contact card",
    "outbound",
    "gtm",
    "lead enrichment",
    "apollo",
    "apollo.io",
    "clearbit",
    "hunter.io",
    "rocketreach",
    "people",
    "yellow pixels"
  ],
  "barWidget": {
    "displayName": "Enricherino",
    "description": "Paste email / LinkedIn / X / phone / Name at company — FIND — contact card. Waterfall under the hood (LeadMagic / ZoomInfo). Unofficial; not a sequencer.",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "right",
    "aliases": [
      "enricherino",
      "yellow pages",
      "yp",
      "contact lookup",
      "people search",
      "email finder",
      "enrich",
      "enrichment",
      "waterfall",
      "leadmagic",
      "zoominfo",
      "zoom info",
      "gtm.ai",
      "gtmai",
      "linkedin",
      "phone lookup",
      "lead enrichment",
      "apollo",
      "clearbit",
      "hunter.io",
      "rocketreach",
      "yellow pixels"
    ],
    "defaults": {
      "leadmagicApiKey": "",
      "zoominfoBearerToken": "",
      "providerMode": "waterfall"
    },
    "schema": [
      {
        "key": "leadmagicApiKey",
        "type": "string",
        "label": "LeadMagic API key",
        "description": "X-API-Key for https://api.leadmagic.io. Leave empty to skip LeadMagic. Never commit real keys.",
        "defaultValue": ""
      },
      {
        "key": "zoominfoBearerToken",
        "type": "string",
        "label": "ZoomInfo / GTM.AI bearer token",
        "description": "Access token for Authorization Bearer on ZoomInfo GTM enrich. Never commit real tokens.",
        "defaultValue": ""
      },
      {
        "key": "providerMode",
        "type": "enum",
        "label": "Provider mode",
        "description": "leadmagic | zoominfo | waterfall (LeadMagic first, then ZoomInfo for missing fields). Default waterfall.",
        "options": [
          "leadmagic",
          "zoominfo",
          "waterfall"
        ],
        "defaultValue": "waterfall"
      }
    ]
  }
}
